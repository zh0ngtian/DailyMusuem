    "DATA_VERSION": "2026-06-19T15:57:49.419906+00:00"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "musuem_muse",
      "database_id": "9ab953e7-0af0-4c08-863a-85717e4fc941"
    }
  ]
}
